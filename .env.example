# Copie este arquivo para .env e preencha os valores antes de executar `docker compose up --build`.
# Nunca versione o .env (RNF-06). Variáveis sem valor são obrigatórias: a aplicação não inicia sem elas.

# Imports absolutos a partir de src/ (guia de desenvolvimento, seção 8.1)
PYTHONPATH=src

# Banco de dados (PostgreSQL 16)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=siaes
POSTGRES_USER=
POSTGRES_PASSWORD=

# JWT (RF-01)
JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=24

# Carga inicial (RF-03)
ADMIN_PASSWORD=
SEED_DEMO=false
DEMO_ATENDENTE_PASSWORD=
DEMO_MECANICO_PASSWORD=

# Rate limiting das rotas públicas (RNF-05)
RATE_LIMIT_PUBLICO=10/minute
